{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "components/**/*",
    "composables/**/*",
    "layouts/**/*",
    "pages/**/*",
    "stores/**/*",
    "utils/**/*",
    "config/**/*",
    "schemas/**/*",
    "server/**/*",
    "types/**/*",
    "app.vue"
  ],
  "exclude": [
    "node_modules",
    ".nuxt",
    "dist"
  ]
}
